{
  "name": "folio",
  "version": "0.1.4",
  "private": true,
  "description": "Darkpages — escrever, organizar e diagramar livros",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "fetch:typst": "node scripts/fetch-typst.mjs",
    "spike:pdf": "tsx scripts/spike-pdf.ts",
    "web": "electron-vite build && tsx src/server/index.ts",
    "web:tailscale": "electron-vite build && FOLIO_HOST=$(tailscale ip -4 | head -1) tsx src/server/index.ts",
    "fetch:fonts": "node scripts/fetch-fonts.mjs",
    "fetch:tesauro": "node scripts/fetch-thesaurus.mjs",
    "languagetool": "bash scripts/languagetool-local.sh",
    "setup": "npm run fetch:typst && npm run fetch:fonts && npm run fetch:tesauro",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist": "electron-vite build && electron-builder --publish never",
    "dist:win": "electron-vite build && electron-builder --win --publish never"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.1.0",
    "@fontsource/cormorant-garamond": "^5.1.0",
    "@fontsource/eb-garamond": "^5.1.0",
    "@fontsource/grenze-gotisch": "^5.1.0",
    "@tiptap/extension-character-count": "^2.27.3",
    "@tiptap/extension-placeholder": "^2.27.3",
    "@tiptap/pm": "^2.27.3",
    "@tiptap/react": "^2.27.3",
    "@tiptap/starter-kit": "^2.27.3",
    "@xyflow/react": "^12.12.1",
    "docx": "^9.15.3",
    "electron-updater": "^6.8.11",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "opentype.js": "^1.3.4",
    "tiptap-markdown": "^0.8.10",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^3.2.4"
  },
  "author": {
    "name": "Mario"
  },
  "license": "MIT",
  "homepage": "https://github.com/samurai-py/darkpages",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samurai-py/darkpages.git"
  },
  "build": {
    "appId": "com.samuraipy.darkpages",
    "productName": "Darkpages",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin"
      },
      {
        "from": "resources/fonts",
        "to": "fonts"
      },
      {
        "from": "resources/thesaurus",
        "to": "thesaurus"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Darkpages-Instalador-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    },
    "artifactName": "Darkpages-${version}-${os}-${arch}.${ext}",
    "portable": {
      "artifactName": "Darkpages-Portatil-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "samurai-py",
        "repo": "darkpages"
      }
    ]
  }
}
